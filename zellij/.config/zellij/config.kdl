// Zellij — multiplexer used inside the dev container (and host if wanted).
// Default keybindings are kept intentionally: the status bar shows the hints,
// which is the discoverability we're after. Docs: https://zellij.dev/documentation

default_shell "fish"
theme "catppuccin-mocha"

// Session persistence: resurrect panes/tabs after a crash or detach.
session_serialization false
serialize_pane_viewport false

// Behaviour
mouse_mode true
copy_on_select true
copy_command "wl-copy"          // Wayland/KDE clipboard
scroll_buffer_size 10000
pane_frames true

ui {
    pane_frames {
        rounded_corners true
        hide_session_name false
    }
}
// Add this to ~/.config/zellij/config.kdl
//
// If you DON'T already have a `keybinds { }` block, paste this whole thing.
// If you DO, just add the two `bind` lines inside your existing
// `shared_except "locked" { }` section.
//
// Alt+Up / Alt+Down = move focus between panes (your top/bottom split),
// directly, with no mode key. (Alt+Left / Alt+Right already switch tabs.)

keybinds {
    shared_except "locked" {
        bind "Alt Up" { MoveFocus "Up"; }
        bind "Alt Down" { MoveFocus "Down"; }
    }
}
