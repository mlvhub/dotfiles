// Zellij — multiplexer used inside the dev container (and host if wanted).
// Colliding Ctrl chords are moved to Alt so Neovim keeps Ctrl p/o/n/t/h.
// The status bar reads bindings from this file, so hints stay accurate.

default_shell "fish"
theme "catppuccin-mocha"

session_serialization false
serialize_pane_viewport false

mouse_mode true
copy_on_select true
scroll_buffer_size 10000
pane_frames true
scrollback_editor "nvim"

ui {
    pane_frames {
        rounded_corners true
        hide_session_name false
    }
}

keybinds {
    shared_except "locked" {
        unbind "Ctrl p" "Ctrl t" "Ctrl n" "Ctrl o" "Ctrl h"
        bind "Alt Up"   { MoveFocus "Up"; }
        bind "Alt Down" { MoveFocus "Down"; }
        bind "Alt Left"  { MoveFocus "Left"; }
        bind "Alt Right" { MoveFocus "Right"; }
        bind "Alt {" { GoToPreviousTab; }
        bind "Alt }" { GoToNextTab; }
    }
    normal {
        bind "Alt p" { SwitchToMode "Pane"; }
        bind "Alt t" { SwitchToMode "Tab"; }
        bind "Alt r" { SwitchToMode "Resize"; }
        bind "Alt s" { SwitchToMode "Session"; }
        bind "Alt m" { SwitchToMode "Move"; }
        bind "Alt z" { ToggleFocusFullscreen; }
    }
    pane {
        unbind "Ctrl p"
        bind "Alt p" "Esc" { SwitchToMode "Normal"; }
    }
    tab {
        unbind "Ctrl t"
        bind "Alt t" "Esc" { SwitchToMode "Normal"; }
    }
    resize {
        unbind "Ctrl n"
        bind "Alt r" "Esc" { SwitchToMode "Normal"; }
    }
    session {
        unbind "Ctrl o"
        bind "Alt s" "Esc" { SwitchToMode "Normal"; }
    }
    move {
        unbind "Ctrl h"
        bind "Alt m" "Esc" { SwitchToMode "Normal"; }
    }
}
