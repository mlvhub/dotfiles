            args "-i" "-C" "distrobox enter dev"
        }
    }

    tab name="SXM" split_direction="vertical" {
        pane split_direction="horizontal" {
            pane name="CC" cwd="/home/valdev/siriusxm/repos" {
                command "fish"
                args "-i" "-C" "distrobox enter dev"
            }
            pane name="SHELL" cwd="/home/valdev/siriusxm/repos" {
                command "fish"
                args "-i" "-C" "distrobox enter dev"
            }
        }
        pane name="EDITOR" cwd="/home/valdev/siriusxm/repos" {
            command "fish"
            args "-i" "-C" "distrobox enter dev"
        }
    }
}
