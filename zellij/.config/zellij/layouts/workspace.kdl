// Zellij workspace — 7 project tabs.
// Install to: ~/.config/zellij/layouts/workspace.kdl
// Launch (0.44.x): zellij --new-session-with-layout workspace --session workspace
//
// Per-tab shape: vertical split 50/50.
//   Left column  (stacked 50/50): CC (top) + SHELL (bottom)
//   Right column (full height):   EDITOR
//
// Panes run an interactive host fish (`fish -i -C ...`) that auto-enters the
// `dev` distrobox. `exit` from the container returns to the HOST shell (pane
// stays open); `dev` re-enters; `exit` from host closes the pane.
//
// ACARPG's CC and SHELL panes stay on the HOST deliberately (no distrobox).
// Its EDITOR pane enters `dev` like every other editor pane.

layout {
    default_tab_template {
        pane size=1 borderless=true { plugin location="zellij:compact-bar"; }
        children
    }

    tab name="ACARPG" focus=true split_direction="vertical" {
        pane split_direction="horizontal" {
            pane name="CC" cwd="/home/valdev/personal/galviagames/Acarpg" {
                command "fish"
            }
            pane name="SHELL" cwd="/home/valdev/personal/galviagames/Acarpg" {
                command "fish"
            }
        }
        pane name="EDITOR" cwd="/home/valdev/personal/galviagames/Acarpg" {
            command "fish"
            args "-i" "-C" "distrobox enter dev"
        }
    }

    tab name="CronTradingSystems" split_direction="vertical" {
        pane split_direction="horizontal" {
            pane name="CC" cwd="/home/valdev/personal/valquant-systems/cron-trading-systems" {
                command "fish"
                args "-i" "-C" "distrobox enter dev"
            }
            pane name="SHELL" cwd="/home/valdev/personal/valquant-systems/cron-trading-systems" {
                command "fish"
                args "-i" "-C" "distrobox enter dev"
            }
        }
        pane name="EDITOR" cwd="/home/valdev/personal/valquant-systems/cron-trading-systems" {
            command "fish"
            args "-i" "-C" "distrobox enter dev"
        }
    }

    tab name="StratPulse" split_direction="vertical" {
        pane split_direction="horizontal" {
            pane name="CC" cwd="/home/valdev/personal/valquant-systems/stratpulse" {
                command "fish"
                args "-i" "-C" "distrobox enter dev"
            }
            pane name="SHELL" cwd="/home/valdev/personal/valquant-systems/stratpulse" {
                command "fish"
                args "-i" "-C" "distrobox enter dev"
            }
        }
        pane name="EDITOR" cwd="/home/valdev/personal/valquant-systems/stratpulse" {
            command "fish"
            args "-i" "-C" "distrobox enter dev"
        }
    }

    tab name="Comalito" split_direction="vertical" {
        pane split_direction="horizontal" {
            pane name="CC" cwd="/home/valdev/personal/puravida-software/comalito" {
                command "fish"
                args "-i" "-C" "distrobox enter dev"
            }
            pane name="SHELL" cwd="/home/valdev/personal/puravida-software/comalito" {
                command "fish"
                args "-i" "-C" "distrobox enter dev"
            }
        }
        pane name="EDITOR" cwd="/home/valdev/personal/puravida-software/comalito" {
            command "fish"
            args "-i" "-C" "distrobox enter dev"
        }
    }

    tab name="Grokkr" split_direction="vertical" {
        pane split_direction="horizontal" {
            pane name="CC" cwd="/home/valdev/personal/puravida-software/grokkr" {
                command "fish"
                args "-i" "-C" "distrobox enter dev"
            }
            pane name="SHELL" cwd="/home/valdev/personal/puravida-software/grokkr" {
                command "fish"
                args "-i" "-C" "distrobox enter dev"
            }
        }
        pane name="EDITOR" cwd="/home/valdev/personal/puravida-software/grokkr" {
            command "fish"
            args "-i" "-C" "distrobox enter dev"
        }
    }

    tab name="NautilusLearning" split_direction="vertical" {
        pane split_direction="horizontal" {
            pane name="CC" cwd="/home/valdev/personal/quant-projects/quant-learning/nautilus-trader-exercises" {
                command "fish"
                args "-i" "-C" "distrobox enter dev"
            }
            pane name="SHELL" cwd="/home/valdev/personal/quant-projects/quant-learning/nautilus-trader-exercises" {
                command "fish"
                args "-i" "-C" "distrobox enter dev"
            }
        }
        pane name="EDITOR" cwd="/home/valdev/personal/quant-projects/quant-learning/nautilus-trader-exercises" {
